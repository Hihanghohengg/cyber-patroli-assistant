# ==============================================================================
# Cyber Patrol Assistant & Social Intelligence — Environment Configuration
# ==============================================================================

# --- [Core Environment] ---
ENV=development
SECRET_KEY=supersecretkey_patrol_2026

# --- [Database Configuration (PostgreSQL 16 with pgvector)] ---
# Docker Compose network: postgresql+psycopg2://patrol_user:patrol_pass@db:5432/patrol_db
# Local development: postgresql+psycopg2://patrol_user:patrol_pass@localhost:5432/patrol_db
DATABASE_URL=postgresql+psycopg2://patrol_user:patrol_pass@localhost:5432/patrol_db

# --- [Redis & Task Broker] ---
# Docker Compose network: redis://redis:6379/0
# Local development: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# --- [Telegram Bot Credentials] ---
# Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_YourBotTokenHere
# Comma-separated list of whitelisted Telegram User IDs (e.g., 12345678,87654321)
TELEGRAM_WHITELISTED_USERS=12345678,87654321
# Optional: Analyst Telegram Group ID for broadcast alerts
TELEGRAM_ANALYST_GROUP_ID=

# --- [Google Gemini Multimodal AI & Embeddings] ---
# Get API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_YourGeminiKeyHere

# --- [Web Dashboard & JWT Authentication] ---
DASHBOARD_SECRET_KEY=dashboard_jwt_secret_patrol_2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Default Initial Administrator:
# Username: admin
# Password: patroladmin2026

# --- [Storage Paths] ---
EVIDENCE_DIR=storage/evidences
REPORTS_DIR=storage/reports

# --- [Trending Topic Engine Weights] ---
# Total weights should sum to 1.00
TRENDING_REFRESH_SECONDS=300
